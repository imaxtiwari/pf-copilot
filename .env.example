# PF Copilot — Environment Template
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgres://user:password@localhost:5432/pf_copilot

# ── Azure OpenAI (required for production) ────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_GPT4O_MINI=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large

# ── pgvector / Qdrant ────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# Optional: comma-separated list of collection names to validate at startup.
# If set, the health probe checks that each collection's vector size matches
# EMBEDDING_DIMENSION (default 1536). A mismatch returns HTTP 503.
QDRANT_COLLECTIONS=
EMBEDDING_DIMENSION=1536

# ── Supabase Auth (required) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: service role key for admin operations (keep secret; never expose to browser).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Upstash Redis (required for production rate limiting) ─────────────────────
# In production these are required; otherwise rate limiting will fail closed.
# In local development the app falls back to an in-memory limiter.
UPSTASH_REDIS_REST_URL=https://your-account.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Policy thresholds (optional overrides) ────────────────────────────────────
# PORTFOLIO_ALLOCATION_TOLERANCE_PCT=0.5
# PORTFOLIO_MAX_SINGLE_FUND_PCT=25
# PORTFOLIO_MAX_REVISIONS=5
# ARIA_MINOR_FAULT_LIMIT=3
# KIRAN_MIN_HEDGE_COVERAGE_PCT=80
# STRUCTURED_OUTPUT_MAX_ATTEMPTS=3
# STRUCTURED_OUTPUT_BASE_DELAY_MS=500

# ── Optional: local development helpers ───────────────────────────────────────
# Set to `true` only in local/test environments. Production ignores this flag.
MOCK_LLM=false
LOG_LEVEL=info

# ── Application settings ──────────────────────────────────────────────────────
# Cookie secret should be a strong random string in production.
COOKIE_SECRET=change-me-to-a-random-string
