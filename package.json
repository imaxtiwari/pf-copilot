{
  "name": "pf-copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx db/migrate.ts",
    "vercel-build": "npm run db:migrate && next build",
    "sync:amfi": "tsx scripts/sync-amfi-master.ts",
    "ingest:factsheets": "tsx scripts/ingest-factsheets.ts",
    "eval:setup": "tsx --env-file=.env.local tests/eval/golden-cas/generate-synthetic.ts",
    "eval": "tsx --env-file=.env.local tests/eval/runner.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-trace-node": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.25.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@tavily/core": "^0.7.8",
    "@types/pdf-parse": "^1.1.5",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "inngest": "^3.19.0",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "openai": "6.39.0",
    "pdf-parse": "^2.4.5",
    "pdf2pic": "^3.2.0",
    "pg": "8.21.0",
    "pino": "10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "25.9.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.7",
    "autoprefixer": "10.5.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.6",
    "happy-dom": "^20.11.2",
    "pdfkit": "^0.18.0",
    "pino-pretty": "13.1.3",
    "playwright": "^1.60.0",
    "postcss": "8.5.15",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
